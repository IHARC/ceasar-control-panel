#!/bin/bash

set -e

if [ "$1" != "configure" ]; then
	exit 0
fi

# This must run before the legacy-user guard: a fresh package install needs
# persistent paths even though the installer creates its first account later.
if getent group ceasarweb > /dev/null && [ -x "/usr/local/ceasar/bin/v-setup-support-runtime" ]; then
	/usr/local/ceasar/bin/v-setup-support-runtime
fi

if [ ! -e "/usr/local/ceasar/data/users/" ]; then
	exit 0
fi

# Existing installations predate the customer module's service-user access to
# the protected configuration directory. Normalize only the directory itself;
# individual configuration files retain their package/installer ownership and
# modes.
if [ -d "/usr/local/ceasar/conf" ] && [ ! -L "/usr/local/ceasar/conf" ] \
	&& getent group ceasarweb > /dev/null; then
	chown root:ceasarweb /usr/local/ceasar/conf
	chmod 0750 /usr/local/ceasar/conf
fi

# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source "$CEASAR/func/main.sh"
source_conf "$CEASAR/conf/ceasar.conf"

if [ -x "/etc/ceasar/hooks/pre_install.sh" ]; then
	/etc/ceasar/hooks/pre_install.sh
fi

new_version="$(dpkg-query -W -f='${Version}' ceasar | sed -E 's/-[0-9]+\+[^~]+//')"
"$BIN/v-change-sys-config-value" VERSION "$new_version"

# Composer dependency trees are shipped in the package. This command verifies
# them and their ownership without contacting an external update service.
"$BIN/v-add-sys-dependencies" verify

# Refresh generated HTTPS redirects so upgrades apply the current native
# generator to domains that already have forced HTTPS enabled. Suspended
# accounts and domains are rebuilt by their normal unsuspend path.
refreshed_ssl_force=no
for user_data in "$CEASAR"/data/users/*; do
	[[ -f "$user_data/user.conf" && -f "$user_data/web.conf" ]] || continue
	unset SUSPENDED
	source_conf "$user_data/user.conf"
	[[ "${SUSPENDED:-no}" != "yes" ]] || continue
	user=${user_data##*/}
	while IFS= read -r domain_record; do
		unset DOMAIN SSL SSL_FORCE SUSPENDED
		parse_object_kv_list "$domain_record"
		[[ "${SSL:-no}" == "yes" && "${SSL_FORCE:-no}" == "yes" &&
			"${SUSPENDED:-no}" != "yes" ]] || continue
		"$BIN/v-add-web-domain-ssl-force" "$user" "$DOMAIN" no yes
		refreshed_ssl_force=yes
	done < "$user_data/web.conf"
done
if [[ "$refreshed_ssl_force" == "yes" ]]; then
	"$BIN/v-restart-web" yes
	"$BIN/v-restart-proxy" yes
fi

systemctl daemon-reload
systemctl enable ceasar-support.timer > /dev/null 2>&1 || true
systemctl start ceasar-support.timer > /dev/null 2>&1 || true
systemctl try-restart ceasar.service > /dev/null 2>&1 || true

if [ -x "/etc/ceasar/hooks/post_install.sh" ]; then
	/etc/ceasar/hooks/post_install.sh
fi

exit 0
