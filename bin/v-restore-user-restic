#!/bin/bash
# info: restore user via Restic
# options: USER SNAPSHOT WEB DNS MAIL DB CRON UDIR
#
# example: v-restore-user-restic user snapshot
#
# This function for restoring database from restic snapshot.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
web=${3:-*}
dns=${4:-*}
mail=${5:-*}
db=${6:-*}
cron=${7:-yes}
udir=${8:-yes}
notify=${9:-no}

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# shellcheck source=/usr/local/ceasar/func/domain.sh
source $CEASAR/func/domain.sh
# shellcheck source=/usr/local/ceasar/func/ip.sh
source $CEASAR/func/ip.sh
# shellcheck source=/usr/local/ceasar/func/rebuild.sh
source $CEASAR/func/rebuild.sh
# shellcheck source=/usr/local/ceasar/func/syshealth.sh
source $CEASAR/func/syshealth.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

source_conf $CEASAR/conf/restic.conf

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

tmpdir=$(mktemp -p /home/$user/tmp/ -d)
if [ ! -f "$tmpdir/backup.conf" ]; then
	restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" dump "$snapshot" "/home/$user/backup/backup.conf" > "$tmpdir/backup.conf"
	if [ "$?" -ne 0 ]; then
		check_result "$E_NOTEXIST" "Invalid snapshot"
	fi
fi

# Download user data
restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" --include "/home/$user/backup/" --target "$tmpdir"
if [ "$?" -ne 0 ]; then
	check_result "$E_NOTEXIST" "Unable to download user data"
fi

# Restore web domains
echo "[ * ] Restore Web domains"
$BIN/v-restore-web-domain-restic "$user" "$snapshot" "$web" 'no' 'no' 'yes' \
	|| check_result "$E_NOTEXIST" "Unable to restore web domains"
echo "[ * ] Restore DNS domains"
$BIN/v-restore-dns-domain-restic "$user" "$snapshot" "$dns" \
	|| check_result "$E_NOTEXIST" "Unable to restore DNS domains"
echo "[ * ] Restore Mail domains"
$BIN/v-restore-mail-domain-restic "$user" "$snapshot" "$mail" \
	|| check_result "$E_NOTEXIST" "Unable to restore Mail domains"
echo "[ * ] Restore Databases"
$BIN/v-restore-database-restic "$user" "$snapshot" "$db" \
	|| check_result "$E_NOTEXIST" "Unable to restore databases"
if [ -n "$cron" ]; then
	echo "[ * ] Restore Cronjobs"
	$BIN/v-restore-cron-job-restic "$user" "$snapshot" \
		|| check_result "$E_NOTEXIST" "Unable to restore Cronjobs"
fi
if [ "$udir" = "yes" ]; then
	echo "[ * ] Restore user files"
	restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" --exclude "/home/$user/web/" --exclude "/home/$user/conf" --exclude "/home/$user/mail" --target /
	if [ "$?" -ne 0 ]; then
		check_result "$E_NOTEXIST" "Unable to download user folders"
	fi
fi

# Rebuilding user
rebuild_user_conf || check_result "$E_RESTART" "Unable to rebuild user configuration"

# The full restore defers the web-child edge transaction until every selected
# native object is restored and Ceasar has rebuilt the user source.
if [[ "$user" =~ ^ih[0-9a-f]{14}$ ]]; then
	"$CEASAR/bin/iharc-customer-isolation" reconcile "$user" "$CEASAR" > /dev/null \
		|| check_result "$E_INVALID" "customer resource isolation could not be reconciled after Restic restore"
fi
if [[ ("$user" =~ ^ih[0-9a-f]{14}$ || "$user" == "$ROOT_USER") && -x "$BIN/iharc-haproxy-cert-sync" ]]; then
	"$BIN/iharc-haproxy-cert-sync" \
		|| check_result "$E_RESTART" "HAProxy authority synchronization could not complete"
fi

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

rm -fr "$tmpdir"

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-user-restic '$user' '$snapshot' /d" $CEASAR/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
$BIN/v-log-action "$user" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
log_event "$OK" "$ARGUMENTS"
exit
