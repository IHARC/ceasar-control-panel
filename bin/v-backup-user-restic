#!/bin/bash
# info: backup system user with all its objects to restic backup
# options: USER NOTIFY
#
# example: v-backup-user-restic admin yes
#
# Backup user with all its objects to restic backup. If the repo doesn't exists a new one will be created.
#

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
# Argument definition
user=$1
notify=${2-no}
# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# shellcheck source=/usr/local/ceasar/func/domain.sh
source $CEASAR/func/domain.sh
# shellcheck source=/usr/local/ceasar/func/db.sh
source $CEASAR/func/db.sh
# shellcheck source=/usr/local/ceasar/func/backup.sh
source $CEASAR/func/backup.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_incremental_backup_enabled

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Set notification email and subject
subj="$user → backup failed"
email=$(grep CONTACT "$CEASAR/data/users/$ROOT_USER/user.conf" | cut -f 2 -d \')

source_conf $CEASAR/conf/restic.conf

if [ ! -f "$USER_DATA/restic.conf" ]; then
	password=$(generate_password '' '32')
	temporary=$(mktemp "$USER_DATA/.restic.conf.XXXXXX") || check_result $E_SYSTEM "Unable to stage restic key"
	(
		umask 077
		printf '%s\n' "$password" > "$temporary"
	) || {
		rm -f -- "$temporary"
		check_result $E_SYSTEM "Unable to write restic key"
	}
	chown root:root "$temporary" && chmod 0600 "$temporary" || {
		rm -f -- "$temporary"
		check_result $E_SYSTEM "Unable to protect restic key"
	}
	[ "$(stat -c '%U:%G:%a' "$temporary")" = root:root:600 ] || {
		rm -f -- "$temporary"
		check_result $E_SYSTEM "Restic key protection is invalid"
	}
	mv -f -- "$temporary" "$USER_DATA/restic.conf" || {
		rm -f -- "$temporary"
		check_result $E_SYSTEM "Unable to publish restic key"
	}
fi
# Earlier native runs created this root-owned key 0644. Tighten that exact
# known state in place so the same key remains usable; reject every other
# ownership or mode rather than replacing a credential.
[ -f "$USER_DATA/restic.conf" ] && [ ! -L "$USER_DATA/restic.conf" ] || check_result $E_SYSTEM "Restic key is unsafe"
[ "$(stat -c '%U:%G:%a' "$USER_DATA/restic.conf")" = root:root:644 ] && chmod 0600 "$USER_DATA/restic.conf"
[ "$(stat -c '%U:%G:%a' "$USER_DATA/restic.conf")" = root:root:600 ] || check_result $E_SYSTEM "Restic key protection is invalid"

# Check if the repository exists and is accessible with the preserved key.
restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" --json snapshots > /dev/null
restic_status=$?
if [ "$restic_status" -eq 10 ]; then
	# A prior first backup may have persisted the key before repository init.
	# Reuse that exact key on the retry.
	restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" init
	if [ $? -ne 0 ]; then
		check_result $E_CONNECT "Unable to create restic repo"
	fi
elif [ "$restic_status" -ne 0 ]; then
	echo "Unable to open restic backup. It might not exists or key is incorrect" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result $E_CONNECT "Unable to access restic repo"
fi

# create backup of the user.conf an database
$BIN/v-backup-user-config $user
export GOMAXPROCS=2
export RESTIC_READ_CONCURRENCY=2
ionice -c2 -n7 nice -n 19 restic --repo "${REPO%/}/$user" --limit-upload 10240 --read-concurrency 2 --password-file $USER_DATA/restic.conf backup /home/$user

if [ $? -ne 0 ]; then
	echo "Unable to create the backup" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result $E_BACKUP "Unable to backup user"
fi

if [[ -n "$SNAPSHOTS" && "$SNAPSHOTS" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-last $SNAPSHOTS"
fi
if [[ -n "$KEEP_DAILY" && "$KEEP_DAILY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-daily $KEEP_DAILY"
fi
if [[ -n "$KEEP_WEEKLY" && "$KEEP_WEEKLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-weekly $KEEP_WEEKLY"
fi
if [[ -n "$KEEP_MONTHLY" && "$KEEP_MONTHLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-monthly $KEEP_MONTHLY"
fi
if [[ -n "$KEEP_YEARLY" && "$KEEP_YEARLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-yearly $KEEP_YEARLY"
fi

restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf forget $restic_prune --prune

# Send notification
if [ -e "$BACKUP/$user.log" ] && [ "$notify" = "yes" ]; then
	subj="$user → backup has been completed"
	email=$(get_user_value '$CONTACT')
	cat $BACKUP/$user.log | $SENDMAIL -s "$subj" "$email" "$notify"
	$BIN/v-add-user-notification "$user" "Snapshot created successfully" "Snap shot of user successfully created"
fi

# Deleting task from queue
sed -i "/v-backup-user-restic $user /d" $CEASAR/data/queue/backup.pipe

# Logging
$BIN/v-log-action "$user" "Info" "Backup" "Backup created."
$BIN/v-log-action "system" "Info" "Backup" "Backup created (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
