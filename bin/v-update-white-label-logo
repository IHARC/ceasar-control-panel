#!/bin/bash
# info: migrate legacy white-label files into the upgrade-safe branding store
# options: none

source /etc/ceasar/ceasar.conf

# The old command copied user files over package-managed images. New installs
# keep assets in $CEASAR/data/branding and serve them through the panel.
"$CEASAR/php/bin/php" -r 'require "/usr/local/ceasar/web/inc/branding.php"; branding_migrate_legacy();'
