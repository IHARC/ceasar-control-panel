#!/bin/bash
# info: add ssh key
# options: USER [FORMAT]
#
# Lists $user/.ssh/authorized_keys

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

format=${2-shell}

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

csv_escape() {
	local value=$1
	value=${value//\"/\"\"}
	printf '%s' "$value"
}

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(echo "$keys" | wc -l)
	echo "{"
	for str in $keys; do
		KEY=${str##*$'\t'}
		ID=${str%$'\t'*}
		json_id=$(printf '%s' "$ID" | jq -Rsa .) || check_result $? "Unable to encode SSH key inventory" "$E_SYSTEM"
		json_key=$(printf '%s' "$KEY" | jq -Rsa .) || check_result $? "Unable to encode SSH key inventory" "$E_SYSTEM"
		printf '    %s: {\n        "ID": %s,\n        "KEY": %s\n        }' "$json_id" "$json_id" "$json_key"
		if [ "$i" -lt "$objects" ]; then
			echo ','
		fi
		((i++))
	done
	echo "}"
}

shell_list() {
	IFS=$'\n'
	echo "ID~KEY"
	echo "----~----~---"
	for str in $keys; do
		KEY=${str##*$'\t'}
		ID=${str%$'\t'*}
		echo "$ID~$KEY"
	done
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	for str in $keys; do
		KEY=${str##*$'\t'}
		ID=${str%$'\t'*}
		printf '%s\t%s\n' "$ID" "$KEY"
	done
}

# CSV list function
csv_list() {
	IFS=$'\n'
	echo "ID,KEY"
	for str in $keys; do
		KEY=${str##*$'\t'}
		ID=${str%$'\t'*}
		escaped_id=$(csv_escape "$ID")
		escaped_key=$(csv_escape "$KEY")
		printf '"%s","%s"\n' "$escaped_id" "$escaped_key"
	done
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

AUTHKEY_FILE="$HOMEDIR/$user/.ssh/authorized_keys"
[ -z "$(readlink -f "$AUTHKEY_FILE" | egrep "^$HOMEDIR/$user/.ssh/")" ] && check_result $E_FORBIDEN "Invalid authorized keys path"

#check if file exsists
if [ ! -f "$AUTHKEY_FILE" ]; then
	exit
fi

# Share the dedicated root-owned lock with add/delete. This inventory remains
# available for a suspended account and cannot observe a torn rewrite.
SSH_KEY_LOCK_DIRECTORY="/run/ceasar/ssh-key-locks"
install -d -o root -g root -m 0700 "$SSH_KEY_LOCK_DIRECTORY" || check_result $? "Unable to prepare SSH key lock" "$E_SYSTEM"
SSH_KEY_LOCK_FILE="$SSH_KEY_LOCK_DIRECTORY/$user.lock"
(umask 077; : >> "$SSH_KEY_LOCK_FILE") || check_result $? "Unable to prepare SSH key lock" "$E_SYSTEM"
exec 9>>"$SSH_KEY_LOCK_FILE" || check_result $? "Unable to open SSH key lock" "$E_SYSTEM"
flock -s 9 || check_result $? "Unable to acquire SSH key lock" "$E_SYSTEM"

first_loop=1
while IFS= read -r l || [ -n "$l" ]; do
	sshkey=$(printf '%s\n' "$l" | LC_ALL=C ssh-keygen -l -E sha256 -f - 2>/dev/null) || continue
	sshkey=${sshkey#* }
	key_fingerprint=${sshkey%% *}
	sshkey=${sshkey#* }
	case "$sshkey" in
		*" ("*) key_id=${sshkey% \(*} ;;
		*) continue ;;
	esac
	[ -n "$key_id" ] || continue
	key="$key_id"$'\t'"$key_fingerprint"
	(($first_loop)) && keys="$key" || keys="$keys"$'\n'"$key"
	unset first_loop
done < "$AUTHKEY_FILE"

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging

exit
