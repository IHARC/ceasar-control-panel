#!/bin/bash
# info: backup all users
# options: NONE
#
# example: v-backup-users
#
# This function backups all system users.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Auto-repair all databases before backuping all accounts
mysqlrepair --all-databases --check --auto-repair > /dev/null 2>&1

if [ "$BACKUP_INCREMENTAL" != "yes" ]; then
	exit 1
fi

backup_status=0
for user in $($BIN/v-list-sys-users plain); do
	check_suspend=$(grep "SUSPENDED='no'" $HESTIA/data/users/$user/user.conf)
	log=$HESTIA/log/backup.log
	if [ ! -f "$HESTIA/data/users/$user/user.conf" ]; then
		continue
	fi
	check_backup_conditions
	backup_incremental=$(grep -E "^BACKUPS_INCREMENTAL=" "$HESTIA/data/users/$user/user.conf")
	if [ "$backup_incremental" != "BACKUPS_INCREMENTAL='yes'" ]; then
		continue
	fi
	check_suspend=$(grep "SUSPENDED='no'" $HESTIA/data/users/$user/user.conf)
	log=$HESTIA/log/backup.log
	if [ -n "$check_suspend" ]; then
		echo -e "================================" >> $log
		echo -e "$user" >> $log
		echo -e "--------------------------------\n" >> $log
		if ! nice -n 19 ionice -c2 -n7 $BIN/v-backup-user-restic $user >> $log 2>&1; then
			backup_status=1
		fi
		echo -e "\n--------------------------------\n\n" >> $log
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit "$backup_status"
