#!/bin/bash
# info: enable the package-owned FileGator distribution
# options: [MODE]

set -e

# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source "$CEASAR/func/main.sh"
source_conf "$CEASAR/conf/ceasar.conf"
source_conf "$CEASAR/install/component-versions.conf"

if [ "$(id -u)" != '0' ]; then
	echo "ERROR: v-add-sys-filemanager can only be executed by root." >&2
	exit 10
fi

check_ceasar_demo_mode

install_dir="$CEASAR/web/fm"
asset="$CEASAR/vendor/filegator/filegator_v${fm_v}.zip"
asset_sha256='d5fd5677ff1a9642a88cebd8d6e4c0929c8e006a63b5219c4fc71ca63a0aba32'

if [ ! -s "$asset" ]; then
	echo "ERROR: Bundled FileGator asset is missing: $asset" >&2
	exit 1
fi
if ! printf '%s  %s\n' "$asset_sha256" "$asset" | sha256sum --check --status; then
	echo "ERROR: Bundled FileGator checksum verification failed." >&2
	exit 1
fi
if ! unzip -tqq "$asset" > /dev/null 2>&1; then
	echo "ERROR: Bundled FileGator asset is not a valid ZIP archive." >&2
	exit 1
fi

staging="$(mktemp -d)"
trap 'rm -rf "$staging"' EXIT
unzip -qq "$asset" -d "$staging"
if [ ! -d "$staging/filegator" ]; then
	echo "ERROR: Bundled FileGator archive has an unexpected layout." >&2
	exit 1
fi

rm -rf "$install_dir"
mkdir -p "$install_dir"
cp -a "$staging/filegator/." "$install_dir/"
cp -a "$CEASAR_INSTALL_DIR/filemanager/filegator/." "$install_dir/"

config_file="$install_dir/configuration.php"
sed -i "s|\(\$dist_config\[\"frontend_config\"\]\[\"app_name\"\] = \"File Manager - \).*\";|\1${APP_NAME}\";|" "$config_file"
printf '%s\n' "$fm_v" > "$install_dir/version"

chown -R root:root "$install_dir"
chown ceasarweb: "$install_dir/private" "$install_dir/private/logs" "$install_dir/repository"

"$BIN/v-change-sys-config-value" FILE_MANAGER true
"$BIN/v-log-action" "system" "Info" "Plugins" "File Manager enabled (Version: $fm_v)."
log_event "$OK" "$ARGUMENTS"
