#!/bin/bash
# info: verify the PHP dependency trees shipped with Ceasar
# options: [MODE]

set -e

# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source "$CEASAR/func/main.sh"
source_conf "$CEASAR/conf/ceasar.conf"

if [ "$(id -u)" != '0' ]; then
	echo "ERROR: v-add-sys-dependencies can only be executed by root." >&2
	exit 10
fi

check_ceasar_demo_mode

php_bin="$CEASAR/php/bin/php"
if [ ! -x "$php_bin" ]; then
	echo "ERROR: The packaged Ceasar PHP runtime is missing: $php_bin" >&2
	exit 1
fi

autoload_inc="$CEASAR/web/inc/vendor/autoload.php"
autoload_src="$CEASAR/web/src/vendor/autoload.php"
autoload_filemanager="$CEASAR/web/fm/vendor/autoload.php"
for autoload in "$autoload_inc" "$autoload_src" "$autoload_filemanager"; do
	if [ ! -r "$autoload" ]; then
		echo "ERROR: Packaged Composer autoloader is missing: $autoload" >&2
		exit 1
	fi
done

"$php_bin" -r "require '$autoload_inc'; exit(function_exists('Ceasar\\\\Shell\\\\quoteshellarg') ? 0 : 1);"
"$php_bin" -r "require '$autoload_src'; exit(class_exists('Ceasar\\\\System\\\\CeasarApp') ? 0 : 1);"
"$php_bin" -r "require '$autoload_filemanager'; exit(class_exists('League\\\\Flysystem\\\\Filesystem') ? 0 : 1);"

chown -R root:root \
	"$CEASAR/web/inc/vendor" \
	"$CEASAR/web/src/vendor" \
	"$CEASAR/web/fm/vendor"

"$BIN/v-log-action" "system" "Info" "Plugins" "Packaged PHP dependencies verified."
log_event "$OK" "$ARGUMENTS"
