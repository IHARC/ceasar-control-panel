#!/bin/bash
# info: add ssh key
# options: USER KEY
#
# example: v-add-user-ssh-key user 'valid ssh key'
#
# Function check if $user/.ssh/authorized_keys exists and create it.
# After that it append the new key(s)

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
key=$2

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER SSH_PUBLIC_KEY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Reading user values
source $USER_DATA/user.conf

# Serialize native key adds and exact-key revokes on a dedicated root-owned
# lock. authorized_keys itself may be atomically replaced by revoke.
SSH_KEY_LOCK_DIRECTORY="/run/ceasar/ssh-key-locks"
install -d -o root -g root -m 0700 "$SSH_KEY_LOCK_DIRECTORY" || check_result $? "Unable to prepare SSH key lock" "$E_SYSTEM"
SSH_KEY_LOCK_FILE="$SSH_KEY_LOCK_DIRECTORY/$user.lock"
(
	umask 077
	: >> "$SSH_KEY_LOCK_FILE"
) || check_result $? "Unable to prepare SSH key lock" "$E_SYSTEM"
exec 9>> "$SSH_KEY_LOCK_FILE" || check_result $? "Unable to open SSH key lock" "$E_SYSTEM"
flock -x 9 || check_result $? "Unable to acquire SSH key lock" "$E_SYSTEM"

AUTHKEY_FILE="$HOMEDIR/$user/.ssh/authorized_keys"
[ -z "$(readlink -f "$AUTHKEY_FILE" | egrep "^$HOMEDIR/$user/.ssh/")" ] && check_result "$E_FORBIDEN" "Invalid authorized keys path"

# Check if file exits
if [ ! -f "$AUTHKEY_FILE" ]; then
	$BIN/v-add-fs-file "$user" "${AUTHKEY_FILE}" || check_result $? "Unable to create SSH key file" "$E_SYSTEM"
fi

[ -z "$key" ] && check_result "$E_NOTEXIST" "Empty ssh public key"

if ! echo "$key" | ssh-keygen -l -f - > /dev/null 2>&1; then
	check_result "$E_PARSING" "Validating user private key"
fi

# Make sure authorized_keys ends with EOL
if [ -f "${AUTHKEY_FILE}" ]; then
	sed -i '$a\' "${AUTHKEY_FILE}" || check_result $? "Unable to update SSH key file" "$E_SYSTEM"
fi

# Append key data to file
printf '%s\n' "$key" >> "$AUTHKEY_FILE" || check_result $? "Unable to add SSH key" "$E_SYSTEM"

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "System" "Added a new SSH key."
log_event "$OK" "$ARGUMENTS"

exit
