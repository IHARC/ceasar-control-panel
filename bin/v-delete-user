#!/bin/bash
# info: delete user
# options: USER [RESTART]
#
# example: v-delete-user whistler
#
# This function deletes a certain user and all his resources such as domains,
# databases, cron jobs, etc.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
restart=$2

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# shellcheck source=/usr/local/ceasar/func/domain.sh
source $CEASAR/func/domain.sh
# shellcheck source=/usr/local/ceasar/func/db.sh
source $CEASAR/func/db.sh
# shellcheck source=/usr/local/ceasar/func/ip.sh
source $CEASAR/func/ip.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Native identity removal is terminal-only. This verifier has no policy
# issuance authority: it requires an already-published terminated policy and
# an observed local blocked state before resource teardown can begin.
if is_iharc_managed_user "$user" && [[ -x "$BIN/v-iharc-transfer-policy" ]]; then
	"$BIN/v-iharc-transfer-policy" "$user" terminal-ready > /dev/null \
		|| check_result "$E_INVALID" "terminal transfer policy is not closed"
fi

if is_iharc_managed_user "$user"; then
	"$CEASAR/bin/iharc-customer-isolation" delete-prep "$user" "$CEASAR" > /dev/null \
		|| check_result "$E_INVALID" "customer resource isolation deletion is not safe"
fi

# Deleting web domains
if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	$BIN/v-unsuspend-web-domains "$user" "$restart"
	$BIN/v-delete-web-domains "$user" "$restart"
	check_result "$?" "web domain deletion failed"
fi

# Deleting dns domains
if [ -n "$DNS_SYSTEM" ] && [ "$DNS_SYSTEM" != 'no' ]; then
	$BIN/v-unsuspend-dns-domains "$user" "$restart"
	$BIN/v-delete-dns-domains "$user" "$restart"
	check_result "$?" "dns domain deletion failed"
fi

# Deleting mail domains
if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/v-unsuspend-mail-domains "$user"
	$BIN/v-delete-mail-domains "$user"
	check_result "$?" "mail domain deletion failed"
fi

# Deleting databases
if is_iharc_managed_user "$user"; then
	"$CEASAR/bin/iharc-customer-isolation" delete-database-prep "$user" "$CEASAR" > /dev/null \
		|| check_result "$E_DB" "customer database isolation could not prepare for deletion"
fi
if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/v-unsuspend-databases "$user"
	$BIN/v-delete-databases "$user"
	check_result "$?" "database deletion failed"
fi

# Unsuspend user just in case
if ! is_iharc_managed_user "$user" || [[ ! -e "/run/iharc-customer-isolation/delete/$user" ]]; then
	$BIN/v-unsuspend-user "$user"
fi

# Releasing user ips
$BIN/v-delete-user-ips "$user"
check_result "$?" "user ip release failed"

# Deleteing user pipes
sed -i "/ $user$/d" "$CEASAR/data/queue/disk.pipe"
sed -i "/ $user$/d" "$CEASAR/data/queue/traffic.pipe"

# Deleting sftp jail
$BIN/v-delete-user-sftp-jail "$user"
if is_iharc_managed_user "$user"; then
	"$CEASAR/bin/iharc-customer-isolation" delete-finalize "$user" "$CEASAR" > /dev/null \
		|| check_result "$E_INVALID" "customer resource isolation deletion is not safe"
fi

# Deleting system user
if [ "$DISK_QUOTA" = 'yes' ]; then
	update_user_group_quota "$user" 'unlimited' || check_result "$E_DISK" "group quota cleanup failed"
fi
/usr/sbin/userdel -f "$user" >> /dev/null 2>&1
if [ $? -ne 0 ]; then
	sed -i "/^$user:/d" /etc/passwd
	sed -i "/^$user:/d" /etc/shadow
fi

/usr/sbin/groupdel "$user" >> /dev/null 2>&1
if [ $? -ne 0 ]; then
	sed -i "/^$user:/d" /etc/group
fi

# Deleting user directories
chattr -i $HOMEDIR/$user/conf > /dev/null 2>&1
rm -rf $HOMEDIR/$user
rm -f /var/spool/mail/$user
rm -f /var/spool/cron/$user
rm -f /var/spool/cron/crontabs/$user
rm -rf $USER_DATA

# Updating admin counter
if [ "$user" != "$ROOT_USER" ]; then
	decrease_user_value "$ROOT_USER" '$U_USERS'
fi

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Users" "User deleted (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
