#!/bin/bash
# info: delete web terminal
# options: NONE
#
# example: v-delete-sys-web-terminal
#
# This function disables the web terminal.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$WEB_TERMINAL" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Updating WEB_TERMINAL value
$BIN/v-change-sys-config-value "WEB_TERMINAL" "false"

# Stopping web terminal websocket server
$BIN/v-stop-service "ceasar-web-terminal"
systemctl disable ceasar-web-terminal

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "Web Terminal" "Web terminal disabled."
log_event "$OK" "$ARGUMENTS"

exit
