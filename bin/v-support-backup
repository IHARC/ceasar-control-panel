#!/bin/bash
# Create a consistent, portable support snapshot including attachments and branding.
set -euo pipefail
umask 077
if [[ $# -ne 1 ]]; then echo "Usage: v-support-backup ARCHIVE.tar" >&2; exit 2; fi
archive=$1
work=$(mktemp -d)
worker_stopped=no
cleanup() {
	if [[ "$worker_stopped" == yes ]]; then systemctl start ceasar-support.timer >/dev/null 2>&1 || true; fi
	rm -rf "$work"
}
trap cleanup EXIT
exec 9>/var/lib/ceasar/support/.lock
flock -x 9
systemctl stop ceasar-support.service >/dev/null 2>&1 || true
worker_stopped=yes
install -d "$work/support" "$work/branding"
if [[ -f /var/lib/ceasar/support/support.sqlite3 ]]; then
	/usr/local/ceasar/php/bin/php -r '$db=new PDO("sqlite:/var/lib/ceasar/support/support.sqlite3"); $db->exec("PRAGMA wal_checkpoint(FULL)"); $db->exec("VACUUM INTO " . $db->quote($argv[1]));' "$work/support/support.sqlite3"
	[[ -d /var/lib/ceasar/support/attachments ]] && cp -a /var/lib/ceasar/support/attachments "$work/support/"
fi
[[ -f /usr/local/ceasar/conf/support.json ]] && install -m 0600 /usr/local/ceasar/conf/support.json "$work/support/config.json"
[[ -d /usr/local/ceasar/data/branding ]] && cp -a /usr/local/ceasar/data/branding/. "$work/branding/"
tar -C "$work" -cf "$archive" support branding
