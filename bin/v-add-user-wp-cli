#!/bin/bash
# info: add wp-cli for a user
# options: USER
#
# example: v-add-user-wp-cli user
#
# This function adds support for wp-cli to the user account

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
update=$2

if [ -z "$CEASAR" ]; then
	CEASAR="/usr/local/ceasar"
fi

# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [UPDATE]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

WPCLI_DIR="/home/$user/.wp-cli"
WPCLI_BIN="$WPCLI_DIR/wp"

if [ -f "$WPCLI_BIN" ]; then
	if [ "$update" = 'yes' ]; then
		user_exec $WPCLI_BIN cli update --yes
		exit
	fi
	check_result "$E_EXISTS" "For user name '$user' WP-CLI already available!"
	exit
fi

[ -z "$(readlink -m "$WPCLI_DIR" | egrep "^$HOMEDIR/$user/")" ] && check_result "$E_FORBIDEN" "Path outside of user homedir (WP Cli dir)"
[ -z "$(readlink -m "$WPCLI_BIN" | egrep "^$HOMEDIR/$user/")" ] && check_result "$E_FORBIDEN" "Path outside of user homedir (WP Cli bin)"

mkdir -p "$WPCLI_DIR"
chown $user:$user "$WPCLI_DIR"

# Cold account egress can reject the first DNS lookup while finite credit is
# issued. Retry within the existing bounds and never cache a failed download.
WPCLI_DOWNLOAD=$(user_exec mktemp "$WPCLI_DIR/wp.XXXXXXXX") \
	|| check_result "$E_DISK" "Unable to stage WP-CLI download"
if ! user_exec wget --tries=3 --timeout=15 --read-timeout=15 --waitretry=3 --no-dns-cache --retry-on-host-error --quiet -O "$WPCLI_DOWNLOAD" https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
	|| ! user_exec test -s "$WPCLI_DOWNLOAD"; then
	user_exec rm -f -- "$WPCLI_DOWNLOAD"
	check_result "$E_CONNECT" "Unable to download WP-CLI"
fi
if ! user_exec chmod +x "$WPCLI_DOWNLOAD" \
	|| ! user_exec mv -f -- "$WPCLI_DOWNLOAD" "$WPCLI_BIN"; then
	user_exec rm -f -- "$WPCLI_DOWNLOAD"
	check_result "$E_DISK" "Unable to publish WP-CLI"
fi
echo "alias wp=/home/"$user"/.wp-cli/wp" >> /home/$user/.bash_aliases

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Plugins" "WP-CLI support enabled."
log_event "$OK" "$ARGUMENTS"

exit
