#!/usr/bin/env python3
"""Print a safe useradd UID_MIN for a canonical IHARC account.

The transfer ledger is the only durable historical identity record.  A Ceasar
account which was deliberately deleted can no longer occupy its former Unix
UID, so a later canonical create must allocate above every retained binding.
This command makes no write and intentionally has no fallback when the
installed ledger cannot establish that floor.
"""

from __future__ import annotations

import os
import sqlite3
import stat
import sys
from pathlib import Path


LEDGER = Path("/var/lib/iharc-transferd/transfer.sqlite3")
LOWEST_REGULAR_UID = 1000
HIGHEST_ALLOCATABLE_UID = 2_147_483_646


def fail(message: str) -> "None":
    print(f"iharc-transfer-uid-floor: {message}", file=sys.stderr)
    raise SystemExit(1)


def require_directory(path: Path, mode: int) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        fail(f"cannot inspect {path}: {error.strerror}")
    if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
        fail(f"unsafe directory: {path}")
    if metadata.st_uid != 0 or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"directory ownership or mode is unsafe: {path}")


def require_ledger(path: Path) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        fail(f"cannot inspect {path}: {error.strerror}")
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
        fail(f"unsafe ledger: {path}")
    if metadata.st_uid != 0 or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600:
        fail("ledger ownership or mode is unsafe")


def main() -> int:
    if os.geteuid() != 0:
        fail("Linux root is required")
    require_directory(LEDGER.parent, 0o700)
    require_ledger(LEDGER)

    try:
        database = sqlite3.connect(f"file:{LEDGER}?mode=ro", uri=True)
        database.execute("PRAGMA query_only = ON")
        integrity = database.execute("PRAGMA integrity_check").fetchone()
        if integrity != ("ok",):
            fail("ledger integrity check failed")
        initialized = database.execute(
            "SELECT value FROM ceasar_meta WHERE key='public_egress_interfaces'"
        ).fetchone()
        if not initialized or not isinstance(initialized[0], str) or not initialized[0]:
            fail("ledger has no completed controller initialization")
        rows = database.execute("SELECT uid FROM ceasar_account_bindings").fetchall()
        # Pre-cutover bindings are immutable identity history, not a runtime
        # policy fallback. Deleted accounts must never release their old UID.
        if database.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='account_bindings'").fetchone():
            rows.extend(database.execute("SELECT uid FROM account_bindings").fetchall())
    except (sqlite3.Error, ValueError) as error:
        fail(f"ledger is unreadable or has an unexpected schema: {error}")
    finally:
        if "database" in locals():
            database.close()

    if not rows:
        # With no retained identity, native useradd's configured regular-user
        # floor remains authoritative.  Do not manufacture a second counter.
        return 0
    uids = [row[0] for row in rows]
    if any(type(uid) is not int or not LOWEST_REGULAR_UID <= uid < HIGHEST_ALLOCATABLE_UID for uid in uids):
        fail("ledger has an unsafe retained UID")
    print(max(uids) + 1)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
