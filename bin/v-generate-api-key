#!/bin/bash
# info: generate api key
# options: NONE
#
# example: v-generate-api-key
#
# This function creates a key file in $CEASAR/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

keygen() {
	tr < /dev/urandom -dc _A-Z-a-z-0-9 | head -c 32
	echo
}
HASH=$(keygen)

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$CEASAR/data/keys/" ]; then
	mkdir -p $CEASAR/data/keys/
	chown ceasarweb:root $CEASAR/data/keys/
	chmod 750 $CEASAR/data/keys/
fi

if [[ -e "$CEASAR/data/keys/$HASH" ]]; then
	while [[ -e "$CEASAR/data/keys/$HASH" ]]; do
		HASH=$(keygen)
	done
fi

touch $CEASAR/data/keys/$HASH
echo "$HASH"

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "System" "New system API key generated (Key: ${HASH})."

exit
