#!/bin/bash
# info: update dns templates
# options: [RESTART]
#
# example: v-update-dns-templates
#
# This function for obtaining updated dns templates from Ceasar package.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
restart=$1

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_format_valid 'restart'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update templates
cp -rf $CEASAR_COMMON_DIR/templates/dns $CEASAR/data/templates/

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Updates" "Default DNS zone templates updated."
exit
