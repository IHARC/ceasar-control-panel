#!/bin/bash
# info: update user disk quota
# options: USER
#
# example: v-update-user-quota alice
#
# The functions updates disk quota for specific user

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update disk quota
# Hard quota quals package value. Soft quota equals 90% of package value.
quota=$(get_user_value '$DISK_QUOTA')
soft=$(echo "$quota * 1024" | bc | cut -f 1 -d .)
hard=$(echo "$quota * 1024" | bc | cut -f 1 -d .)

# Searching home mount point
mnt=$(df -P /home | awk '{print $6}' | tail -n1)

# Checking unlimited quota
if [ "$quota" = 'unlimited' ]; then
	setquota $user 0 0 0 0 $mnt 2> /dev/null
else
	setquota $user $soft $hard 0 0 $mnt 2> /dev/null
fi

# Managed customer storage uses one primary-group allowance across web and
# MariaDB data. Standalone accounts retain Ceasar's native per-user quota.
if is_iharc_managed_user "$user"; then
	update_user_group_quota "$user" "$quota" || check_result "$E_DISK" "group quota update failed"
fi

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
