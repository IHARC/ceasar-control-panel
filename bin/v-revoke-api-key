#!/bin/bash
# info: revokes api key
# options: [HASH]
#
# example: v-revoke-api-key mykey
#
# This function removes a key from in $CEASAR/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/ceasar/ceasar.conf
source /etc/ceasar/ceasar.conf
# shellcheck source=/usr/local/ceasar/func/main.sh
source $CEASAR/func/main.sh
# load config file
source_conf "$CEASAR/conf/ceasar.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

hash=$1

args_usage='HASH'
check_args '1' "$#" "$args_usage"
is_format_valid 'hash'

# Perform verification if read-only mode is enabled
check_ceasar_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$CEASAR/data/keys/" ]; then
	exit "$E_NOTEXIST"
fi

if [[ -e "$CEASAR/data/keys/$hash" ]]; then
	rm $CEASAR/data/keys/$hash
else
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Ceasar                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "System API key revoked (Key: $hash)."
log_event "$OK" "$ARGUMENTS"

exit
